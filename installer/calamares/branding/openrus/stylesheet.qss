/* OpenRUS Calamares Cyberpunk Theme */

QWidget {
    background-color: #090d16;
    color: #e2e8f0;
    font-family: "Segoe UI", "Ubuntu", sans-serif;
    font-size: 13px;
}

QTreeView, QListView, QTableView {
    background-color: #0f172a;
    alternate-background-color: #162035;
    border: 1px solid #00f3ff;
    border-radius: 8px;
    selection-background-color: #ff007f;
    selection-color: #ffffff;
}

QPushButton {
    background-color: #162035;
    border: 1px solid #00f3ff;
    border-radius: 8px;
    padding: 8px 18px;
    color: #00f3ff;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #00f3ff;
    color: #000000;
}

QPushButton:pressed {
    background-color: #ff007f;
    border-color: #ff007f;
    color: #ffffff;
}

QPushButton:disabled {
    background-color: #0b0f19;
    border-color: #2d3748;
    color: #4a5568;
}

QProgressBar {
    background-color: #0f172a;
    border: 1px solid #00f3ff;
    border-radius: 6px;
    text-align: center;
    color: #ffffff;
    font-weight: bold;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #00f3ff, stop:1 #ff007f);
    border-radius: 5px;
}

QLabel {
    background: transparent;
}

QComboBox {
    background-color: #0f172a;
    border: 1px solid #00f3ff;
    border-radius: 6px;
    padding: 6px 10px;
    color: #ffffff;
}
